# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# The publishable key is safe in the browser; row-level security protects the data.
# Never put the secret (service role) key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Morning notifications (optional; the app works without them) ---
# Server only. Supabase → Project Settings → API Keys → Secret key.
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Push notifications. Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email through Resend (resend.com). The sender must be on a domain you verified there.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Client Manager <reminders@your-domain.lk>

# Vercel sends this with the daily job; any long random string.
CRON_SECRET=
