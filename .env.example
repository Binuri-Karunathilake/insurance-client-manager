# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# The publishable key is safe in the browser; row-level security protects the data.
# Never put the secret (service role) key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
